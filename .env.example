# Environment Variables Template for M&M Artsy Shop (LIKHA)
# Copy this file to .env.local for local development. Do not commit actual secrets to git.

NODE_VERSION=20
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Admin Server-Side Secret Credentials (DO NOT prefix with NEXT_PUBLIC_)
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_secure_admin_password_here
