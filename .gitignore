# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.cert
*.crt

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# environment variables & secrets (NEVER commit secrets to GitHub)
.env
.env*.local
.env.development
.env.test
.env.production
.env.local
.env*
!.env.example

# database backups / credentials
*.sql
*.dump
*.backup

# vercel & hosting metadata
.vercel
.render

# typescript
*.tsbuildinfo
next-env.d.ts
